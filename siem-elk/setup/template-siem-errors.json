{
  "index_patterns": ["logs-errors-*"],
  "template": {
    "settings": {
      "index.lifecycle.name": "siem-logs-policy",
      "index.number_of_shards": 1,
      "index.number_of_replicas": 0
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "error.type": { "type": "keyword" },
        "error.message": { "type": "text" }
      }
    }
  },
  "priority": 100
}
